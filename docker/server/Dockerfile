FROM authentik/server:2026.8.5

ARG POSTGRESQL_ADDON_HOST
ARG POSTGRESQL_ADDON_DB
ARG POSTGRESQL_ADDON_PASSWORD
ARG POSTGRESQL_ADDON_USER
ARG POSTGRESQL_ADDON_PORT
ARG CELLAR_ADDON_HOST
ARG CELLAR_ADDON_KEY_ID
ARG CELLAR_ADDON_KEY_SECRET
ARG CC_REVERSE_PROXY_IPS

# PSQL
ENV AUTHENTIK_POSTGRESQL__HOST=$POSTGRESQL_ADDON_HOST
ENV AUTHENTIK_POSTGRESQL__NAME=$POSTGRESQL_ADDON_DB
ENV AUTHENTIK_POSTGRESQL__PASSWORD=$POSTGRESQL_ADDON_PASSWORD
ENV AUTHENTIK_POSTGRESQL__USER=$POSTGRESQL_ADDON_USER
ENV AUTHENTIK_POSTGRESQL__PORT=$POSTGRESQL_ADDON_PORT

# S3 storage
ENV AUTHENTIK_STORAGE__MEDIA__BACKEND="s3"
ENV AUTHENTIK_STORAGE__MEDIA__S3__ACCESS_KEY=$CELLAR_ADDON_KEY_ID
ENV AUTHENTIK_STORAGE__MEDIA__S3__BUCKET_NAME="authentik-media"
ENV AUTHENTIK_STORAGE__MEDIA__S3__ENDPOINT="https://${CELLAR_ADDON_HOST}"
ENV AUTHENTIK_STORAGE__MEDIA__S3__SECRET_KEY=$CELLAR_ADDON_KEY_SECRET
ENV AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
ENV AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"

# Other settings
ENV AUTHENTIK_LISTEN__HTTP=0.0.0.0:8080
# Add a /32 after each ip from  CC_REVERSE_PROXY_IPS
ENV AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=${CC_REVERSE_PROXY_IPS//,//32,}/32

CMD ["server"]